# 묘항 — 환경변수 견본. 이 파일은 커밋되지만, 실제 값이 든 .env 는 .gitignore 로 제외된다.
#
# 쓰는 법 (Git Bash):
#   cp .env.example .env      # 값 채우기
#   set -a; . ./.env; set +a; (cd src/Harbor.Server/bin/Debug/net8.0 && ./Harbor.Server.exe)
#
# 값을 저장소·채팅·스크린샷 어디에도 붙여넣지 말 것. 유출되면 새로 발급하고 옛 것을 폐기한다.
#
# ⚠ **값은 반드시 작은따옴표로 감싼다.** 접속 문자열에는 공백(`SSL Mode`)과 `;` 가 들어 있어서,
#    따옴표가 없으면 셸이 `;` 에서 줄을 끊고 `SSL` 을 명령으로 실행하려 든다(변수에는 앞부분만 담긴다).

# ── PostgreSQL 접속 문자열 (Npgsql 형식) ────────────────────────────────
# Supabase: Project Settings → Database → Connection string. Npgsql 형식(키=값;)으로 옮겨 적는다.
#
# ① 직접 연결 — 가장 단순하지만 IPv6 전용이라 국내 IPv4 회선에서는 안 붙을 수 있다.
# HARBOR_DB='Host=db.xxxxxxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=여기;SSL Mode=Require;Trust Server Certificate=true'
#
# ② Session pooler — IPv4. 상주 프로세스(게임 서버)에 적합. ①이 안 되면 이걸 쓴다.
#    Username 이 `postgres.<프로젝트ref>` 형태인 점에 주의.
# HARBOR_DB='Host=aws-0-ap-northeast-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.xxxxxxxx;Password=여기;SSL Mode=Require;Trust Server Certificate=true'
#
# ③ Transaction pooler(6543)는 서버리스용. 굳이 쓸 거면 `;Max Auto Prepare=0;No Reset On Close=true` 를 덧붙인다.
HARBOR_DB=

# ── 입장권(ticket) 서명 키 ──────────────────────────────────────────────
# 웹이 발급하고 게임 서버가 검증한다. 두 곳이 같은 값을 가져야 한다.
# 만드는 법: openssl rand -hex 32
HARBOR_TICKET_SECRET=

# ── 관리 API 토큰 ───────────────────────────────────────────────────────
# 게임 서버의 /admin/* 을 여는 열쇠. **이 값이 없으면 /admin 은 아예 등록되지 않는다.**
# 만드는 법: py tools/new-secret.py HARBOR_ADMIN_TOKEN   (값을 화면에 찍지 않는다)
#
# ⚠ **브라우저로 절대 내려보내지 않는다.** 관리자 화면(Next.js)의 **서버 라우트**에서만 쓴다.
#    이 토큰 하나면 전체 공지·강제 퇴장·루피 지급이 전부 가능하다.
HARBOR_ADMIN_TOKEN=

# ── 공개 주소 (보통 손으로 넣지 않는다) ────────────────────────────────
# 밖에서 브라우저가 붙을 주소. 서버가 켜질 때 DB(`server_endpoint`)에 적고, 웹이 읽어 간다
# → 터널 주소가 바뀌어도 **Vercel 재배포가 필요 없다.**
#
# `bash tools/run-public.sh` 가 cloudflared 출력에서 읽어 자동으로 넣어 주므로 비워 두면 된다.
# 고정 도메인이 생겼다면 여기에 직접 적고 `bash tools/run-server.sh` 로 띄워도 된다.
# 비어 있으면 서버는 주소를 알리지 않는다(안쪽에서만 접속 가능).
# HARBOR_PUBLIC_WS=wss://game.example.com/ws

# ── 선택 ────────────────────────────────────────────────────────────────
# 게임 서버 주소를 클라이언트에 강제로 지정할 때만 (보통은 입장권이 알려 준다)
# HARBOR_HOST=
# HARBOR_PORT=30000
