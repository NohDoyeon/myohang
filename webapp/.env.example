# 묘항 웹앱 — 환경변수 견본. 실제 값이 든 .env.local 은 .gitignore 로 제외된다.
#
# 로컬:   cp .env.example .env.local  후 값 채우기 (저장소 루트 .env 에서 옮겨 오면 된다)
# 배포:   Vercel → Settings → Environment Variables 에 같은 이름으로. **바꾸면 Redeploy 해야 반영된다.**

# ── 브라우저가 붙을 게임 서버 주소 ──────────────────────────────────────
# 이것만 NEXT_PUBLIC_ 이다. **공개 주소라서** 붙여도 되는 것이고,
# 비밀 값에는 절대 붙이지 않는다(번들에 그대로 박힌다).
#   로컬:  ws://localhost:8080/ws
#   배포:  wss://<터널주소>/ws     ← cloudflared tunnel --url http://localhost:8080 이 알려 준다
NEXT_PUBLIC_GAME_WS=ws://localhost:8080/ws

# ── 아래는 서버에서만 쓴다. 브라우저로 내려가지 않는다. ──────────────────

# Postgres 접속 문자열. Npgsql 형식(Host=…;Port=…)과 URI 형식(postgresql://…) 둘 다 된다.
# 서버리스(Vercel)에서는 **6543 트랜잭션 풀러**가 맞다.
HARBOR_DB=

# 입장권 서명 키. **게임 서버(.env)와 같은 값이어야 한다** — 다르면 게임이 입장권을 거부한다.
# 만드는 법: py tools/new-secret.py HARBOR_TICKET_SECRET (값을 화면에 찍지 않는다)
HARBOR_TICKET_SECRET=
